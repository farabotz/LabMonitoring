# Salin lewat bootstrap --init-env untuk menghasilkan secret acak; jangan commit .env.
LABACCESS_APP_NAME=LabAccess
LABACCESS_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/labaccess
LABACCESS_SIGNING_KEY=GENERATE_RANDOM_MINIMUM_32_CHARACTERS
LABACCESS_BIOMETRIC_KEY=GENERATE_FERNET_KEY_OUTSIDE_DATABASE
LABACCESS_HEARTBEAT_SECONDS=10
LABACCESS_STALE_SECONDS=30
LABACCESS_GRACE_MINUTES=30
LABACCESS_RETENTION_DAYS=90
LABACCESS_FACE_ENABLED=false
LABACCESS_FACE_THRESHOLD=0.50
LABACCESS_MODELS_DIR=models
LABACCESS_VEYON_URL=https://admin-lab:11080
LABACCESS_VEYON_KEY_NAME=labaccess
LABACCESS_VEYON_PRIVATE_KEY_PATH=C:/ProgramData/LabAccess/secrets/veyon_private.pem
LABACCESS_VEYON_CA=C:/ProgramData/LabAccess/ca.pem
